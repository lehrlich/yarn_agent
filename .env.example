# Anthropic API key for the agent's reasoning
ANTHROPIC_API_KEY=your_api_key_here

# Ravelry API credentials (if using their API instead of scraping)
# Get these from: https://www.ravelry.com/pro/developer
RAVELRY_ACCESS_KEY=your_access_key
RAVELRY_PERSONAL_KEY=your_personal_key

# Rate limiting (requests per second)
RAVELRY_RATE_LIMIT=1
